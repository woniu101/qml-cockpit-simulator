#include <windows.h>
1 ICON "@APP_ICON_PATH@"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@APP_PRODUCT@\0"
            VALUE "ProductName", "@APP_PRODUCT@\0"
            VALUE "FileVersion", "0.1.0.0\0"
            VALUE "ProductVersion", "0.1.0.0\0"
            VALUE "OriginalFilename", "@APP_FILENAME@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
